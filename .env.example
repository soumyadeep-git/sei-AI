# Copy to .env and fill in. Never commit .env.

# Speech-to-text and text-to-speech
DEEPGRAM_API_KEY=

# LLM (also used by the eval judge)
GROQ_API_KEY=

# Verifies media streams come from Twilio, and hangs up after the closing line
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPGRAM_VOICE=aura-2-thalia-en
